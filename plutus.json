            },
            {
              "title": "arbitration",
              "description": "Arbitration panel. Its power is bounded on both sides by `Arbitrate`:\n it can only pick a figure between what the buyer declared and what the\n supplier sealed.",
              "$ref": "#/definitions/bonlivraison~1types~1Arbitration"
            },
