    "bonlivraison/types/State": {
      "title": "State",
      "description": "Successive states of an order.",
      "anyOf": [
        {
          "title": "Created",
          "description": "The buyer has issued a request and locked the escrow.",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "request",
              "$ref": "#/definitions/bonlivraison~1types~1Commitment"
            }
          ]
        },
        {
          "title": "Accepted",
          "description": "The supplier has committed to a set of lines and an amount.",
          "dataType": "constructor",
          "index": 1,
          "fields": [
            {
              "title": "lines",
              "$ref": "#/definitions/bonlivraison~1types~1Commitment"
            },
            {
              "title": "total",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "Shipped",
          "description": "The supplier sealed its manifest BEFORE the buyer declared anything.\n That precedence is what makes the reconciliation probative.\n\n `shipped_at` is the UPPER bound of the sealing transaction's validity\n range — the latest slot at which it could have been accepted. See\n `tx.event_time` for why the lower bound would be forgeable.",
          "dataType": "constructor",
          "index": 2,
          "fields": [
            {
              "title": "manifest",
              "$ref": "#/definitions/bonlivraison~1types~1Commitment"
            },
            {
              "title": "manifest_total",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "shipped_at",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "Disputed",
          "description": "The two declarations diverge beyond the tolerance.\n\n `declared_at` is an upper bound, for the same reason as `shipped_at`.",
          "dataType": "constructor",
          "index": 3,
          "fields": [
            {
              "title": "manifest_total",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "accepted_total",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "receipt",
              "$ref": "#/definitions/bonlivraison~1types~1Commitment"
            },
            {
              "title": "declared_at",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "bonlivraison/types/Terms": {
      "title": "Terms",
      "description": "Contractual parameters, frozen at creation and never mutable afterwards.",
      "anyOf": [
        {
          "title": "Terms",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "acceptance_deadline",
              "description": "Deadline (POSIX ms) past which the supplier can no longer accept and the\n buyer recovers the escrow.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "reception_window",
              "description": "Delay (ms) granted to the buyer after shipment to declare what was\n received. Past that delay, silence counts as accepting the manifest.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "dispute_window",
              "description": "Delay (ms) granted to the arbiter to settle a dispute. Past that delay,\n the buyer's declared figure prevails.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "tolerance",
              "description": "Triviality threshold (lovelace). Below it, the gap is credited to the\n buyer automatically: arbitrating would cost more than the gap itself.",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
