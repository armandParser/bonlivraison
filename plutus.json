            }
          ]
        }
      ]
    },
    "bonlivraison/types/Terms": {
      "title": "Terms",
      "description": "Contractual parameters, frozen at creation and never mutable afterwards.",
      "anyOf": [
        {
          "title": "Terms",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "acceptance_deadline",
              "description": "Deadline (POSIX ms) past which the supplier can no longer accept and the\n buyer recovers the deposit.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "reception_window",
              "description": "Delay (ms) granted to the buyer after shipment to declare what was\n received. Past that delay, silence counts as accepting the manifest.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "dispute_window",
              "description": "Delay (ms) granted to the arbiter to settle a dispute. Past that delay,\n the buyer's declared figure prevails.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "tolerance",
              "description": "Triviality threshold, in euro cents. Below it, the gap is credited to\n the buyer automatically: arbitrating would cost more than the gap.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "abandon_grace",
              "description": "Extra delay (ms) after which a stalled order may be closed by anyone.\n\n Two states could otherwise never close: `Accepted` with a supplier that\n never ships (`Ship` carries no deadline of its own), and `Shipped` once\n the buyer's window has run out and the supplier does not claim. Both are\n reachable by one party simply going quiet.\n\n It is deliberately long — a fortnight, not hours. Its job is to bound the\n life of a dead order, never to race a live one: on the `Shipped` path the\n supplier keeps its exclusive claim for the whole of this delay, and it is\n the supplier submitting for itself that makes the fee its own.\n\n Not bounded by the validator. The supplier reads the whole datum before\n signing `Accept`, so an unreasonable value is refused there, off-chain,\n like every other term.",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
