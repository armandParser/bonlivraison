    "bonlivraison/types/Action": {
      "title": "Action",
      "description": "Permitted transitions.",
      "anyOf": [
        {
          "title": "Accept",
          "description": "Supplier: commits to the lines and the amount.",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "lines",
              "$ref": "#/definitions/bonlivraison~1types~1Commitment"
            },
            {
              "title": "total",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "Cancel",
          "description": "Buyer (or anyone once the deadline has passed): closes and returns\n the deposit. Nothing was ever owed on-chain.",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        },
        {
          "title": "Ship",
          "description": "Supplier: seals the manifest as the truck departs.",
          "dataType": "constructor",
          "index": 2,
          "fields": [
            {
              "title": "manifest",
              "$ref": "#/definitions/bonlivraison~1types~1Commitment"
            },
            {
              "title": "manifest_total",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "Declare",
          "description": "Buyer: declares what was received. `accepted_total` is the result of the\n min() rule computed off-chain over the lines.",
          "dataType": "constructor",
          "index": 3,
          "fields": [
            {
              "title": "receipt",
              "$ref": "#/definitions/bonlivraison~1types~1Commitment"
            },
            {
              "title": "accepted_total",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "ClaimSilence",
          "description": "Supplier — or anyone, once `abandon_grace` has run on top of the\n reception window: the buyer's silence counts as accepting the manifest.\n\n Opening this to a stranger takes nothing from the supplier. The figure\n this path records is the manifest the supplier sealed itself in `Ship`,\n and the contract already treats it as agreed once the buyer's window\n closes. Submitting is bookkeeping, not a declaration.",
          "dataType": "constructor",
          "index": 4,
          "fields": []
        },
        {
          "title": "Arbitrate",
          "description": "Panel: records the arbitrated figure, bounded by\n [accepted_total, manifest_total]. Records it; moves nothing.",
          "dataType": "constructor",
          "index": 5,
          "fields": [
            {
              "title": "final_total",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "CloseDispute",
          "description": "The arbiter never ruled: the buyer's figure prevails.",
          "dataType": "constructor",
          "index": 6,
          "fields": []
        },
        {
          "title": "Abandon",
          "description": "Anyone: the supplier accepted and never shipped. Closes the order and\n returns the deposit.\n\n Only from `Accepted`. Nothing left the warehouse and neither side ever\n declared a figure, so this closes the record without attesting anything\n — the one state where that is the correct reading. `Shipped` is served\n by `ClaimSilence`, which has a figure to record.\n\n Anchored on `acceptance_deadline + abandon_grace`. `Accept` requires the\n transaction to fall entirely before the deadline and this one entirely\n after the grace, so the two can never both be valid.",
          "dataType": "constructor",
          "index": 7,
          "fields": []
        }
      ]
    },
    "bonlivraison/types/Arbitration": {
      "title": "Arbitration",
      "description": "Arbitration panel: an M-of-N set of keys entitled to rule on a dispute.\n\n A single arbiter key would make whoever holds it the trusted third party\n this design exists to remove — and if it were the platform's own key, the\n platform would be arbitrating disputes over a record it also profits from.\n A threshold across independent holders is what makes the record adoptable\n by suppliers who have no reason to trust the platform.\n\n Well-formedness (distinct keys, `1 <= threshold <= length(keys)`) is\n enforced once, at minting, because that is the only point where this\n datum is created rather than carried forward by `continues`.",
      "anyOf": [
        {
          "title": "Arbitration",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "keys",
              "description": "Distinct verification keys. Duplicates would let one signature count\n more than once towards the threshold.",
              "$ref": "#/definitions/List$aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "threshold",
              "description": "Minimum number of distinct panel signatures required to rule.",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
